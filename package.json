{
	"name": "hestia",
	"private": true,
	"version": "1.10.5",
	"description": "An open-source Linux web server control panel.",
	"repository": "https://github.com/hestiacp/hestiacp",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "npm@11.21.0",
	"scripts": {
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"docs:test": "vitest run --config docs/.vitepress/vitest.config.js",
		"build": "node build.js",
		"lint": "prettier --cache --check . && biome lint . && markdownlint-cli2 *.md docs/**/*.md",
		"lint-staged": "lint-staged",
		"format": "prettier --cache --write .",
		"preinstall": "npx only-allow npm",
		"prepare": "husky"
	},
	"dependencies": {
		"@alpinejs/collapse": "^3.17.4",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"alpinejs": "^3.17.4",
		"chart.js": "^4.5.1",
		"check-password-strength": "^3.0.0",
		"floating-vue": "^5.4.0",
		"nanoid": "^6.0.2",
		"normalize.css": "^8.0.1",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@prettier/plugin-php": "^0.25.0",
		"@testing-library/vue": "^8.1.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"browserslist": "^4.29.3",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"markdownlint-cli2": "^0.23.3",
		"prettier": "^3.9.9",
		"prettier-plugin-nginx": "^2.0.0",
		"prettier-plugin-sh": "^0.20.2",
		"prettier-plugin-sql": "^0.20.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.11",
		"vue": "^3.5.43"
	},
	"browserslist": [
		"defaults"
	],
	"overrides": {
		"vite": "^6.4.4",
		"postcss": {
			"nanoid": "^6.0.2"
		}
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
