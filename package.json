{
	"name": "hestia",
	"private": true,
	"version": "1.10.10",
	"description": "An open-source Linux web server control panel.",
	"repository": "https://github.com/hestiacp/hestiacp",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "npm@11.21.3",
	"scripts": {
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"docs:test": "vitest run --config docs/.vitepress/vitest.config.js",
		"build": "node build.js",
		"test:studio": "node --test test/studio*.test.mjs",
		"lint": "prettier --cache --check . && biome lint . && markdownlint-cli2 *.md docs/**/*.md",
		"lint-staged": "lint-staged",
		"format": "prettier --cache --write .",
		"preinstall": "npx only-allow npm",
		"prepare": "husky"
	},
	"dependencies": {
		"@alpinejs/collapse": "^3.17.5",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"alpinejs": "^3.17.5",
		"chart.js": "^4.6.1",
		"check-password-strength": "^3.0.0",
		"floating-vue": "^5.4.0",
		"nanoid": "^6.0.2",
		"normalize.css": "^8.0.1",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@prettier/plugin-php": "^0.26.0",
		"@testing-library/vue": "^8.1.0",
		"@vitejs/plugin-vue": "^6.0.11",
		"browserslist": "^4.29.6",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.2",
		"markdownlint-cli2": "^0.24.2",
		"prettier": "^3.10.1",
		"prettier-plugin-nginx": "^2.0.0",
		"prettier-plugin-sh": "^0.20.2",
		"prettier-plugin-sql": "^0.20.0",
		"vitepress": "^1.6.4",
		"vitest": "^5.1.1",
		"vue": "^3.5.46"
	},
	"browserslist": [
		"defaults"
	],
	"overrides": {
		"vite": "^6.4.6",
		"postcss": {
			"nanoid": "^6.0.2"
		},
		"katex": "^0.19.1"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
