#!/bin/bash
# info: delete ssh key
# options: USER KEY
#
# example: v-delete-user-ssh-key user unique_id
#
# Delete user ssh key from authorized_keys

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
keyid=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source "$HESTIA/func/main.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# Additional argument formatting

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER KEYID'
is_format_valid 'user'
is_no_new_line_format "$keyid"
is_object_valid 'user' 'USER' "$user"

source "$USER_DATA/user.conf"

AUTHKEY_FILE="$HOMEDIR/$user/.ssh/authorized_keys"
if ! readlink -f "$AUTHKEY_FILE" | grep -Eq "^$HOMEDIR/$user/.ssh/"; then
	check_result "$E_FORBIDEN" "Invalid authorized keys path"
fi

if [ ! -f "$AUTHKEY_FILE" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

TMP_AUTHKEY_FILE=$(mktemp)
trap 'rm -f "$TMP_AUTHKEY_FILE"' EXIT

awk -v id="$keyid" '{
    value = $0
    sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, "", value)

    if (value != id)
        print
}' "$AUTHKEY_FILE" > "$TMP_AUTHKEY_FILE"
chown --reference="$AUTHKEY_FILE" "$TMP_AUTHKEY_FILE"
chmod --reference="$AUTHKEY_FILE" "$TMP_AUTHKEY_FILE"
mv "$TMP_AUTHKEY_FILE" "$AUTHKEY_FILE"
trap - EXIT

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
"$BIN/v-log-action" "$user" "Info" "SSH" "SSH key deleted (Key ID: $keyid)."
log_event "$OK" "$ARGUMENTS"

exit
