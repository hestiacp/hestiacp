#!/bin/bash
# info: restore file or folder
# options: USER SNAPSHOT path
#
# example: v-restore-user user snapshot path
#
# This function for restoring database from restic snapshot.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
file=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# shellcheck source=/usr/local/hestia/func/ip.sh
source $HESTIA/func/ip.sh
# shellcheck source=/usr/local/hestia/func/rebuild.sh
source $HESTIA/func/rebuild.sh
# shellcheck source=/usr/local/hestia/func/syshealth.sh
source $HESTIA/func/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT FILE [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
if [ -z "$file" ] || [[ "$file" == *, ]] || [[ "$file" == ,* ]] || [[ "$file" == *,,* ]]; then
	check_result "$E_INVALID" "Invalid file format :: $file"
fi
IFS=',' read -r -a file_list <<< "$file"
for file_path in "${file_list[@]}"; do
	is_dir_path_format_valid "$file_path" 'file'
	if [[ "$file_path" != "/home/$user/"?* ]] || [[ "$file_path" == "/home/$user/conf" ]] || [[ "$file_path" == "/home/$user/conf/"* ]]; then
		check_result "$E_INVALID" "Invalid file format :: $file"
	fi
done
is_object_valid 'user' 'USER' "$user"

source_conf $HESTIA/conf/restic.conf

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Stage in root-owned $BACKUP, not the user's home, to avoid races
# where the user swaps the tmp dir before root reads/writes it
tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d)
if [ ! -f "$tmpdir/backup.conf" ]; then
	restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" dump "$snapshot" "/home/$user/backup/backup.conf" > "$tmpdir/backup.conf"
	if [ "$?" -ne 0 ]; then
		rm -rf "$tmpdir"
		check_result "$E_NOTEXIST" "Unable to download snapshot data"
	fi
fi

for file_path in "${file_list[@]}"; do
	# Never let restic (root) write into the user controlled home directory
	if ! restic_restore_user_path "$snapshot" "${file_path#/home/$user/}"; then
		rm -rf "$tmpdir"
		check_result "$E_NOTEXIST" "Unable to restore file from snapshot"
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

rm -rf "$tmpdir"

# Update user counters
$BIN/v-update-user-counters "$user"
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "\|v-restore-file-restic '$user' '$snapshot' '$file' |d" $HESTIA/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "File successfully restored (User: $user, Snapshot: $snapshot, File: $file)."
$BIN/v-log-action "$user" "Info" "Backup" "File successfully restored (User: $user, Snapshot: $snapshot, File: $file)."
log_event "$OK" "$ARGUMENTS"
exit
