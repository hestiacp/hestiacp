#!/bin/bash
# info: restart php interpreter
# options: NONE
#
# example: v-restart-web-backend
#
# This function reloads php interpreter configuration.

restart=$1
# For backward compatibility might change in the feature
version=$2

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

send_email_report() {
	email=$(grep CONTACT "$HESTIA/data/users/$ROOT_USER/user.conf")
	email=$(echo "$email" | cut -f 2 -d "'")
	subj="$(hostname): $WEB_BACKEND restart failed"
	cat $tmpfile | $SENDMAIL -s "$subj" $email
	[[ -f "$tmpfile" ]] && rm -f $tmpfile
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_format_valid 'restart'

if [ -n "$version" ]; then
	if [[ ! $version =~ ^[0-9]+\.[0-9]+ ]]; then
		echo "The specified PHP version format is invalid, it should look like [0-9].[0-9]."
		echo "Example: 7.0, 7.4, 8.0"
		exit "$E_INVALID"
	fi
fi
#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Exit
if [ -z "$WEB_BACKEND" ] || [ "$WEB_BACKEND" = 'remote' ]; then
	exit
fi

if [ "$1" = "no" ]; then
	exit
fi

# Schedule restart
if [ "$1" = 'scheduled' ] || [ -z "$1" ] && [ "$SCHEDULED_RESTART" = 'yes' ]; then
	sed -i "/\/$SCRIPT now/d" $HESTIA/data/queue/restart.pipe
	echo "$BIN/$SCRIPT now" >> $HESTIA/data/queue/restart.pipe
	exit
fi

tmpfile=$(mktemp)

# php-fpm refuses to start when a single pool is invalid (for example a pool
# whose user no longer exists). Restarting it with such a pool takes down every
# website that uses that PHP version, not only the one that changed. Test the
# configuration first and, if it fails, keep the running master untouched.
fpm_config_test() {
	if [ -x "/usr/sbin/php-fpm$1" ]; then
		"/usr/sbin/php-fpm$1" -t >> "$tmpfile" 2>&1
	fi
}

failed=''
if [ -z "$version" ]; then
	# Substitute php-fpm service name formats
	for version in $($BIN/v-list-sys-php plain); do
		v_php="php$version-fpm"
		if [ ! -f "/etc/php/${version}/fpm/pool.d/dummy.conf" ]; then
			cp -f "$HESTIA_INSTALL_DIR/php-fpm/dummy.conf" "/etc/php/${version}/fpm/pool.d/"
			sed -i "s/9999/99${version//./}/g" "/etc/php/${version}/fpm/pool.d/dummy.conf"
		fi

		# A broken version must not stop the restart of the others
		if ! fpm_config_test "$version"; then
			failed="$failed $v_php(config)"
			continue
		fi
		$BIN/v-restart-service "$v_php" "$restart"
		if [ $? -ne 0 ]; then
			failed="$failed $v_php"
		fi
	done
else
	v_php="php$version-fpm"
	if ! fpm_config_test "$version"; then
		failed="$v_php(config)"
	else
		$BIN/v-restart-service "$v_php" "$restart"
		if [ $? -ne 0 ]; then
			failed="$v_php"
		fi
	fi
fi

if [ -n "$failed" ]; then
	send_email_report
	check_result "$E_RESTART" "restart failed:$failed"
fi

# Update restart queue
if [ -e "$HESTIA/data/queue/restart.pipe" ]; then
	sed -i "/\/$SCRIPT now/d" $HESTIA/data/queue/restart.pipe
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

[[ -f "$tmpfile" ]] && rm -f $tmpfile
exit
