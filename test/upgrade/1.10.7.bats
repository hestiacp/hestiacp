#!/usr/bin/env bats
#
# Test for the Roundcube vendor/ marker repair in v-add-sys-roundcube.
# Roundcube's installto.sh only replaces vendor/ when vendor/autoload.php
# carries a "generated by Roundcube" marker. Composer removes that marker
# whenever it regenerates the autoloader, so a vendor/ update by
# update_rc_modules() makes the next upgrade look like a Composer-managed
# install and skips vendor/ (hestiacp#5997).
#
# Restoring the marker makes installto.sh rsync --delete the release vendor/
# over the installed one, so most of these cases assert that the marker is
# NOT restored: anything the release does not ship would be deleted.

load '../test_helper/bats-support/load'
load '../test_helper/bats-assert/load'

setup() {
    # The marker is appended as the webmail user, so these tests need root and
    # that user. The CI container runs as root and creates hestiamail.
    if [[ "$(id -u)" != "0" ]] || ! id hestiamail > /dev/null 2>&1; then
        skip "needs root and the hestiamail user"
    fi

    HESTIA="${HESTIA:-/usr/local/hestia}"
    workdir=$(mktemp -d)
    install_dir="${workdir}/roundcube"
    mkdir -p "${install_dir}/vendor/composer" \
        "${install_dir}/program/include" \
        "${install_dir}/roundcubemail-1.7.6"

    printf "define('RCMAIL_VERSION', '1.7.5');\n" > "${install_dir}/program/include/iniset.php"

    # The extracted release: composer.lock is what the guard compares against,
    # and vendor/ is the tree installto.sh rsyncs over the installed one
    cat > "${install_dir}/roundcubemail-1.7.6/composer.lock" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "symfony/polyfill-php84" }
    ]
}
EOF
    mkdir -p "${install_dir}/roundcubemail-1.7.6/vendor/bacon/bacon-qr-code"
    printf '<?php\n' > "${install_dir}/roundcubemail-1.7.6/vendor/autoload.php"
    printf '<?php\n' > "${install_dir}/roundcubemail-1.7.6/vendor/bacon/bacon-qr-code/BaconQrCode.php"

    # A package-managed install: Roundcube's composer.json, and a vendor/ that
    # holds one of the packages the release ships
    cat > "${install_dir}/composer.json" <<'EOF'
{
    "name": "roundcube/roundcubemail",
    "require": {
        "php": ">=8.1",
        "bacon/bacon-qr-code": "^3.0.0"
    }
}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" }
    ]
}
EOF
    mkdir -p "${install_dir}/vendor/bacon/bacon-qr-code"
    printf '<?php\n' > "${install_dir}/vendor/bacon/bacon-qr-code/BaconQrCode.php"

    # vendor/autoload.php as Composer rewrites it, i.e. without the marker
    printf '<?php\n\nreturn ComposerAutoloaderInit123::getLoader();\n' > "${install_dir}/vendor/autoload.php"

    # The real tree is owned by the webmail user, and the marker is written as
    # that user, so the fixture has to match or the write is refused. The
    # parent must be traversable too: /var/lib/roundcube is, but mktemp's 0700
    # directory is not.
    if id hestiamail > /dev/null 2>&1; then
        chmod 755 "${workdir}"
        chown -R hestiamail:www-data "${install_dir}/vendor"
    fi

    # Pull the function under test out of the real script
    sed -n '/^restore_vendor_marker() {/,/^}$/p' \
        "${HESTIA}/bin/v-add-sys-roundcube" > "${workdir}/func.sh"

    export RC_INSTALL_DIR="${install_dir}"
    export RC_EXTRACT="roundcubemail-1.7.6"
    export PHP_CLI="/usr/bin/php"
    export rc_v="1.7.6"
}

teardown() {
    rm -rf "${workdir}"
}

run_restore() {
    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker"
    assert_success
}

marker_count() {
    grep -c "generated by Roundcube" "${install_dir}/vendor/autoload.php" || true
}

@test "Roundcube: vendor marker is restored for a package-managed install" {
    run_restore
    assert_equal "$(marker_count)" "1"
    run grep -q "generated by Roundcube install 1.7.5" "${install_dir}/vendor/autoload.php"
    assert_success
}

@test "Roundcube: vendor marker is restored when the caller chowns the tree first" {
    # installto.sh and composer run as root, so the tree can be root-owned when
    # this runs. Both call sites chown -R before calling, and the write then
    # happens as hestiamail.
    chown -R root:root "${install_dir}/vendor"
    chown -R hestiamail:www-data "${install_dir}/vendor"

    run_restore
    assert_equal "$(marker_count)" "1"
}

@test "Roundcube: vendor marker is not restored when the file is not hestiamail's" {
    # The function must never chown the file itself: that would let a swapped
    # path hand a root-owned file to the webmail user.
    chown -R root:root "${install_dir}/vendor"

    run_restore
    assert_equal "$(marker_count)" "0"
    run stat -c %U "${install_dir}/vendor/autoload.php"
    assert_output "root"
}

@test "Roundcube: vendor marker is not restored when the install has extra requirements" {
    # A plugin installed with Composer must keep its vendor/ untouched
    cat > "${install_dir}/composer.json" <<'EOF'
{
    "name": "roundcube/roundcubemail",
    "require": {
        "php": ">=8.1",
        "mstilkerich/rcmcarddav": "^5.0"
    }
}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "mstilkerich/rcmcarddav" }
    ]
}
EOF
    mkdir -p "${install_dir}/vendor/mstilkerich/rcmcarddav"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored for a plugin directory no package accounts for" {
    # Files placed in vendor/ by hand are not in installed.json
    mkdir -p "${install_dir}/vendor/acme/customplugin"
    printf '<?php\n' > "${install_dir}/vendor/acme/customplugin/Plugin.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored for a file at the top of vendor/" {
    printf '<?php\n' > "${install_dir}/vendor/singlefile.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is restored when a package is a newer version than the release" {
    # update_rc_modules() runs composer update, so a shipped package can hold
    # files the release tarball does not have. That must not block the repair.
    mkdir -p "${install_dir}/vendor/nette/utils/src/Utils"
    printf '<?php\n' > "${install_dir}/vendor/nette/utils/src/Utils/DateTimeImmutable.php"
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "nette/utils" }
    ]
}
EOF
    cat > "${install_dir}/roundcubemail-1.7.6/composer.lock" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "nette/utils" }
    ]
}
EOF

    run_restore
    assert_equal "$(marker_count)" "1"
}

@test "Roundcube: vendor marker is not restored for a dot directory in vendor/" {
    mkdir -p "${install_dir}/vendor/.evil"
    printf '<?php\n' > "${install_dir}/vendor/.evil/x.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when composer.json is truncated" {
    # A failed edit or composer run leaves valid but empty JSON
    printf '{}\n' > "${install_dir}/composer.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: a refusal says which file or package caused it" {
    # The upgrade log is the only place an admin sees why the repair was
    # skipped, so a silent exit is not good enough.
    printf '{}\n' > "${install_dir}/composer.json"

    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker 2>&1"
    assert_output --partial "composer.json is not a Roundcube composer.json"
}

@test "Roundcube: malformed JSON reports the parse error instead of failing silently" {
    printf 'not json\n' > "${install_dir}/composer.json"

    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker 2>&1"
    assert_output --partial "JsonException"
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when composer.json is not Roundcube's" {
    printf '{ "require": {} }\n' > "${install_dir}/composer.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when installed.json is unreadable" {
    printf 'not json\n' > "${install_dir}/vendor/composer/installed.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored without a release composer.lock" {
    rm -f "${install_dir}/roundcubemail-1.7.6/composer.lock"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not written through a symlink" {
    # vendor/ is owned by the webmail user, which could plant a link here
    local victim="${workdir}/victim"
    printf 'untouched\n' > "${victim}"
    rm -f "${install_dir}/vendor/autoload.php"
    ln -s "${victim}" "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(cat "${victim}")" "untouched"
}

@test "Roundcube: vendor marker is not written through a hardlink" {
    local victim="${workdir}/victim"
    printf 'untouched\n' > "${victim}"
    rm -f "${install_dir}/vendor/autoload.php"
    ln "${victim}" "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(cat "${victim}")" "untouched"
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: no temporary file is left behind in vendor/" {
    run_restore
    assert_equal "$(marker_count)" "1"
    run bash -c "ls -a '${install_dir}/vendor' | grep -c '^\\.autoload' || true"
    assert_output "0"
}

@test "Roundcube: vendor marker is left alone when it is already present" {
    printf '// generated by Roundcube install 1.7.5\n' >> "${install_dir}/vendor/autoload.php"
    local sha_before
    sha_before=$(sha256sum "${install_dir}/vendor/autoload.php" | cut -d" " -f1)

    run_restore
    assert_equal "$(sha256sum "${install_dir}/vendor/autoload.php" | cut -d" " -f1)" "${sha_before}"
}

@test "Roundcube: restored marker keeps the file valid PHP without a trailing newline" {
    printf '<?php\n\nreturn ComposerAutoloaderInit123::getLoader();' > "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(marker_count)" "1"
    run "${PHP_CLI}" -l "${install_dir}/vendor/autoload.php"
    assert_success
}

prepare_roundcube_sandbox() {
    local sb_hestia="${workdir}/hestia"
    local sb_etc="${workdir}/etc/hestiacp"
    local sb_config="${workdir}/etc_roundcube"
    local sb_log="${workdir}/log_roundcube"
    local sb_logrotate="${workdir}/logrotate.d"
    local sb_home="${workdir}/home"
    local sb_pkg="${workdir}/pkg/roundcubemail-1.7.6"

    mkdir -p \
        "${sb_hestia}/func" \
        "${sb_hestia}/conf" \
        "${sb_hestia}/bin" \
        "${sb_hestia}/install/upgrade" \
        "${sb_hestia}/install/common/roundcube" \
        "${sb_etc}" \
        "${sb_config}" \
        "${sb_log}" \
        "${sb_logrotate}" \
        "${sb_home}/admin/.composer" \
        "${sb_pkg}/bin" \
        "${sb_pkg}/program/include" \
        "${sb_pkg}/vendor/bacon/bacon-qr-code" \
        "${install_dir}/bin"

    cat > "${sb_etc}/hestia.conf" <<EOF
export HESTIA="${sb_hestia}"
EOF
    cat > "${sb_hestia}/func/main.sh" <<'EOF'
OK=0
source_conf() { source "$1"; }
check_hestia_demo_mode() { :; }
log_event() { :; }
EOF
    : > "${sb_hestia}/func/db.sh"
    cat > "${sb_hestia}/conf/hestia.conf" <<EOF
DB_SYSTEM='mysql'
ROOT_USER='admin'
HOMEDIR='${sb_home}'
HESTIA_COMMON_DIR='${sb_hestia}/install/common'
BIN='${sb_hestia}/bin'
WEBMAIL_SYSTEM='roundcube'
EOF
    cat > "${sb_hestia}/install/upgrade/upgrade.conf" <<'EOF'
rc_v='1.7.6'
EOF
    cat > "${sb_hestia}/bin/v-list-default-php" <<'EOF'
#!/bin/bash
echo "8.2"
EOF
    cat > "${sb_hestia}/bin/v-log-action" <<'EOF'
#!/bin/bash
exit 0
EOF
    cat > "${sb_hestia}/bin/v-add-user-composer" <<'EOF'
#!/bin/bash
exit 1
EOF
    chmod +x \
        "${sb_hestia}/bin/v-list-default-php" \
        "${sb_hestia}/bin/v-log-action" \
        "${sb_hestia}/bin/v-add-user-composer"

    # Existing Roundcube 1.7.5 config + symlink (mirroring production layout)
    printf "<?php\n// original-config-sentinel\n" > "${sb_config}/config.inc.php"
    ln -s "${sb_config}/" "${install_dir}/config"
    printf "#!/usr/bin/env php\n<?php\n// old update\n" > "${install_dir}/bin/update.sh"
    chmod +x "${install_dir}/bin/update.sh"

    # Synthetic Roundcube 1.7.6 tarball mimicking upstream installto.sh + update.sh
    printf "<?php\ndefine('RCMAIL_VERSION', '1.7.6');\n" > "${sb_pkg}/program/include/iniset.php"
    cp "${install_dir}/roundcubemail-1.7.6/composer.lock" "${sb_pkg}/composer.lock"
    printf '{"name":"roundcube/roundcubemail","require":{"php":">=8.1"}}\n' > "${sb_pkg}/composer.json"
    printf '<?php\n// generated by Roundcube install 1.7.6\n' > "${sb_pkg}/vendor/autoload.php"
    printf '<?php\n' > "${sb_pkg}/vendor/bacon/bacon-qr-code/BaconQrCode.php"
    printf '#!/usr/bin/env php\n<?php\nexit(0);\n' > "${sb_pkg}/bin/indexcontacts.sh"

    cat > "${sb_pkg}/bin/installto.sh" <<'EOF'
#!/usr/bin/env php
<?php
class rcube {
    public static function raise_error($msg, $log = false, $die = false) {
        fwrite(STDERR, "ERROR: $msg\n");
        if ($die) {
            exit(1);
        }
    }
}
if (!function_exists('system')) {
    rcube::raise_error('PHP system() function is required', false, true);
}
$target_dir = rtrim(end($_SERVER['argv']), '/');
$src_dir = dirname(__DIR__);
$autoload = @file_get_contents("{$target_dir}/vendor/autoload.php");
$dirs = ['bin', 'program'];
if ($autoload !== false && strpos($autoload, 'generated by Roundcube') !== false) {
    $dirs[] = 'vendor';
}
foreach ($dirs as $dir) {
    $cmd = "rsync -aC --out-format=%n --delete {$src_dir}/{$dir}/ {$target_dir}/{$dir}/";
    if (system($cmd, $ret) === false || $ret > 0) {
        rcube::raise_error("Failed to execute: {$cmd}", false, true);
    }
}
$command = "cd {$target_dir} && " . \PHP_BINARY . " bin/update.sh --version=1.7.5 -y";
$errors = [];
if (system($command, $ret) === false || $ret > 0) {
    $errors[] = "Failed to execute command: {$command}";
}
if (!empty($errors)) {
    rcube::raise_error(implode("\n", $errors), false, true);
}
echo "All done.\n";
EOF

    cat > "${sb_pkg}/bin/update.sh" <<'EOF'
#!/usr/bin/env php
<?php
if (getenv('MOCK_UPDATE_FAIL') === '1') {
    fwrite(STDERR, "Simulated update.sh failure\n");
    exit(1);
}
if (!function_exists('system') || !function_exists('exec')) {
    fwrite(STDERR, "system/exec disabled in update.sh\n");
    exit(1);
}
$autoload = @file_get_contents(dirname(__DIR__) . '/vendor/autoload.php');
if ($autoload === false || strpos($autoload, 'generated by Roundcube') === false) {
    $which = trim((string) shell_exec('which composer 2>/dev/null'));
    if ($which === '') {
        fwrite(STDERR, "composer not found on PATH\n");
        exit(1);
    }
    $composer_bin = \PHP_BINARY . " {$which}";
    system("{$composer_bin} update -d " . escapeshellarg(dirname(__DIR__)) . ' --no-dev', $exit_code);
    exit($exit_code);
}
exit(0);
EOF
    chmod +x "${sb_pkg}/bin/installto.sh" "${sb_pkg}/bin/update.sh" "${sb_pkg}/bin/indexcontacts.sh"

    tar czf "${workdir}/roundcubemail-1.7.6-complete.tar.gz" -C "${workdir}/pkg" "roundcubemail-1.7.6"
    cp "${workdir}/roundcubemail-1.7.6-complete.tar.gz" "${install_dir}/roundcubemail-1.7.6-complete.tar.gz"

    # Rewrite only environment-config paths in a sandboxed copy so host paths stay untouched
    sed \
        -e "s|source /etc/hestiacp/hestia.conf|source \"${sb_etc}/hestia.conf\"|" \
        -e "s|RC_INSTALL_DIR=\"/var/lib/roundcube\"|RC_INSTALL_DIR=\"${install_dir}\"|" \
        -e "s|RC_CONFIG_DIR=\"/etc/roundcube\"|RC_CONFIG_DIR=\"${sb_config}\"|" \
        -e "s|RC_LOG=\"/var/log/roundcube\"|RC_LOG=\"${sb_log}\"|" \
        -e "s|/etc/logrotate.d/|${sb_logrotate}/|g" \
        "${HESTIA}/bin/v-add-sys-roundcube" > "${workdir}/v-add-sys-roundcube"
    chmod +x "${workdir}/v-add-sys-roundcube"

    chown -R hestiamail:www-data "${install_dir}" "${sb_config}"
}

@test "Roundcube: vendor marker is restored when RC_EXTRACT_DIR is staged outside RC_INSTALL_DIR" {
    mkdir -p "${workdir}/staged"
    mv "${install_dir}/roundcubemail-1.7.6" "${workdir}/staged/roundcubemail-1.7.6"
    export RC_EXTRACT_DIR="${workdir}/staged/roundcubemail-1.7.6"

    run_restore
    assert_equal "$(marker_count)" "1"
}

@test "Roundcube: upgrade succeeds via staged Composer PHAR when vendor marker is skipped and system/exec are disabled in php.ini" {
    prepare_roundcube_sandbox

    # Install an extra Composer requirement so restore_vendor_marker intentionally skips
    cat > "${install_dir}/composer.json" <<'EOF'
{
    "name": "roundcube/roundcubemail",
    "require": {
        "php": ">=8.1",
        "mstilkerich/rcmcarddav": "^5.0"
    }
}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "mstilkerich/rcmcarddav" }
    ]
}
EOF
    mkdir -p "${install_dir}/vendor/mstilkerich/rcmcarddav"
    printf '<?php\n// keep-plugin\n' > "${install_dir}/vendor/mstilkerich/rcmcarddav/Plugin.php"
    chown -R hestiamail:www-data "${install_dir}/vendor"

    # Real Composer-style PHP PHAR in HOMEDIR/$ROOT_USER/.composer/composer
    cat > "${workdir}/home/admin/.composer/composer" <<'EOF'
#!/usr/bin/env php
<?php
if (!function_exists('proc_open')) {
    fwrite(STDERR, "proc_open disabled in composer\n");
    exit(1);
}
if (getenv('COMPOSER_ALLOW_SUPERUSER') !== '1' || getenv('COMPOSER_NO_INTERACTION') !== '1' || !getenv('COMPOSER_HOME')) {
    fwrite(STDERR, "Missing Composer env vars\n");
    exit(1);
}
file_put_contents(getenv('MOCK_COMPOSER_LOG'), implode(' ', $argv) . "\n", FILE_APPEND);
exit(0);
EOF
    chmod +x "${workdir}/home/admin/.composer/composer"

    # Non-PHP shell wrapper lower on PATH that PHP_BINARY would choke on if preferred
    mkdir -p "${workdir}/badbin"
    cat > "${workdir}/badbin/composer" <<'EOF'
#!/bin/sh
echo "bad wrapper ran" >> "${MOCK_BAD_COMPOSER_LOG}"
exit 99
EOF
    chmod +x "${workdir}/badbin/composer"

    printf "disable_functions = system,exec,proc_open\n" > "${workdir}/php.ini"

    local orig_update_sha
    orig_update_sha="$(sha256sum "${workdir}/pkg/roundcubemail-1.7.6/bin/update.sh" | cut -d" " -f1)"

    run env \
        -u COMPOSER_HOME \
        -u COMPOSER_NO_INTERACTION \
        -u COMPOSER_ALLOW_SUPERUSER \
        PATH="${workdir}/badbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        PHPRC="${workdir}/php.ini" \
        MOCK_COMPOSER_LOG="${workdir}/composer.log" \
        MOCK_BAD_COMPOSER_LOG="${workdir}/bad_composer.log" \
        bash "${workdir}/v-add-sys-roundcube"
    assert_success

    run grep -q "'1.7.6'" "${install_dir}/program/include/iniset.php"
    assert_success
    assert [ -f "${install_dir}/vendor/mstilkerich/rcmcarddav/Plugin.php" ]
    assert [ -f "${workdir}/composer.log" ]
    assert [ ! -f "${workdir}/bad_composer.log" ]
    assert_equal "$(sha256sum "${install_dir}/bin/update.sh" | cut -d" " -f1)" "${orig_update_sha}"
    assert [ ! -e "${install_dir}/roundcubemail-1.7.6-complete.tar.gz" ]
    assert [ ! -e "${install_dir}/roundcubemail-1.7.6" ]
}

@test "Roundcube: failed upgrade rolls back iniset.php and config so retry is not blocked" {
    prepare_roundcube_sandbox

    run env \
        MOCK_UPDATE_FAIL=1 \
        bash "${workdir}/v-add-sys-roundcube"
    assert_failure
    assert_output --partial "Simulated update.sh failure"

    # iniset.php and config.inc.php must both be restored to pre-upgrade state
    run grep -q "'1.7.5'" "${install_dir}/program/include/iniset.php"
    assert_success
    run grep -q "original-config-sentinel" "${workdir}/etc_roundcube/config.inc.php"
    assert_success
    assert [ ! -e "${install_dir}/roundcubemail-1.7.6-complete.tar.gz" ]
    assert [ ! -e "${install_dir}/roundcubemail-1.7.6" ]

    # Retrying after fixing the underlying failure must proceed cleanly
    cp "${workdir}/roundcubemail-1.7.6-complete.tar.gz" "${install_dir}/roundcubemail-1.7.6-complete.tar.gz"
    run bash "${workdir}/v-add-sys-roundcube"
    assert_success
    run grep -q "'1.7.6'" "${install_dir}/program/include/iniset.php"
    assert_success
}

@test "Roundcube: symlink on RC_INSTALL_DIR or unsafe ROOT_USER composer symlink is rejected" {
    prepare_roundcube_sandbox

    # Case 1: symlink at RC_INSTALL_DIR must abort before writing
    local victim_dir="${workdir}/victim_rc"
    mkdir -p "${victim_dir}"
    printf 'untouched\n' > "${victim_dir}/marker"
    rm -rf "${install_dir}"
    ln -s "${victim_dir}" "${install_dir}"

    run bash "${workdir}/v-add-sys-roundcube"
    assert_failure
    assert_equal "$status" "2"
    assert_output --partial "must not be a symlink"
    assert_equal "$(cat "${victim_dir}/marker")" "untouched"

    # Case 2: symlinked ROOT_USER composer pointing outside home must be skipped cleanly
    rm -f "${install_dir}"
    mkdir -p "${install_dir}/vendor/composer" "${install_dir}/program/include"
    printf "define('RCMAIL_VERSION', '1.7.5');\n" > "${install_dir}/program/include/iniset.php"
    cat > "${install_dir}/composer.json" <<'EOF'
{"name":"roundcube/roundcubemail","require":{"php":">=8.1","bacon/bacon-qr-code":"^3.0.0"}}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{"packages":[{"name":"bacon/bacon-qr-code"}]}
EOF
    mkdir -p "${install_dir}/vendor/bacon/bacon-qr-code"
    printf '<?php\n\nreturn ComposerAutoloaderInit123::getLoader();\n' > "${install_dir}/vendor/autoload.php"
    ln -s "${workdir}/etc_roundcube/" "${install_dir}/config"
    cp "${workdir}/roundcubemail-1.7.6-complete.tar.gz" "${install_dir}/roundcubemail-1.7.6-complete.tar.gz"
    chown -R hestiamail:www-data "${install_dir}"

    cat > "${workdir}/outside_composer" <<'EOF'
<?php
file_put_contents(getenv('MOCK_UNSAFE_LOG'), "ran\n");
exit(0);
EOF
    chmod +x "${workdir}/outside_composer"
    ln -s "${workdir}/outside_composer" "${workdir}/home/admin/.composer/composer"

    run env \
        MOCK_UNSAFE_LOG="${workdir}/unsafe.ran" \
        bash "${workdir}/v-add-sys-roundcube"
    assert_success
    assert_output --partial "Unsafe symlink detected"
    assert [ ! -e "${workdir}/unsafe.ran" ]
}
