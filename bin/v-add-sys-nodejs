#!/bin/bash
# info: add Node.js version for web domain applications
# options: VERSION
#
# example: v-add-sys-nodejs 22
#
# This function installs the latest release of a Node.js major version from
# nodejs.org into /opt/hestia/nodejs/VERSION, verified against the official
# SHA256 checksums. Web domain applications can then select it with
# v-add-web-domain-app / v-change-web-domain-app. Running it again updates the
# version to the latest release of that major line.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/app.sh
source $HESTIA/func/app.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'VERSION'
if ! [[ "$version" =~ ^[0-9]{2,3}$ ]] || [ "$version" -lt 18 ]; then
	check_result "$E_INVALID" "invalid Node.js major version :: $version (18 or newer)"
fi

case "$(uname -m)" in
	x86_64) arch='x64' ;;
	aarch64) arch='arm64' ;;
	*) check_result "$E_NOTEXIST" "unsupported architecture $(uname -m)" ;;
esac

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

base_url="https://nodejs.org/dist/latest-v${version}.x"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

if ! curl -fsSL --max-time 60 "$base_url/SHASUMS256.txt" -o "$tmpdir/SHASUMS256.txt"; then
	check_result "$E_NOTEXIST" "Node.js $version is not available on nodejs.org"
fi
tarball=$(grep -oE "node-v[0-9.]+-linux-${arch}\.tar\.xz$" "$tmpdir/SHASUMS256.txt" | head -n1)
if [ -z "$tarball" ]; then
	check_result "$E_NOTEXIST" "no linux-$arch build of Node.js $version found"
fi

curl -fsSL --max-time 600 "$base_url/$tarball" -o "$tmpdir/$tarball"
check_result $? "download of $tarball failed"
(cd "$tmpdir" && grep " $tarball\$" SHASUMS256.txt | sha256sum -c --status)
check_result $? "checksum verification of $tarball failed"

# Install next to the old release, then swap it in
mkdir -p "$APP_NODE_DIR"
chmod 755 /opt/hestia "$APP_NODE_DIR" 2> /dev/null
target="$APP_NODE_DIR/$version"
mkdir "$tmpdir/node"
tar -xJf "$tmpdir/$tarball" -C "$tmpdir/node" --strip-components=1 --no-same-owner
check_result $? "unable to extract $tarball"
chown -R root:root "$tmpdir/node"
chmod -R go-w "$tmpdir/node"
chmod 755 "$tmpdir/node"
rm -rf "$target.old"
[ -d "$target" ] && mv "$target" "$target.old"
mv "$tmpdir/node" "$target"
rm -rf "$target.old"

installed=$("$target/bin/node" --version 2> /dev/null)
check_result $? "Node.js $version does not run on this system"

# Restart running apps that use this version
for conf in "$HESTIA"/data/users/*/app.conf; do
	[ -f "$conf" ] || continue
	app_user=$(basename "$(dirname "$conf")")
	while IFS= read -r line; do
		[[ "$line" =~ ^DOMAIN=\'([^\']+)\'.*\ RUNTIME=\'node\'\ VERSION=\'$version\'.*\ STATUS=\'running\' ]] || continue
		systemctl try-restart "$(app_unit_name "$app_user" "${BASH_REMATCH[1]}")" > /dev/null 2>&1
	done < "$conf"
done

echo "Node.js $installed installed in $target"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "Node.js $installed installed for web domain applications."
log_event "$OK" "$ARGUMENTS"

exit
