#!/bin/bash
# info: upgrade a verified legacy user password hash
# options: USER PASSWORD
#
# example: v-upgrade-user-password-hash admin /tmp/password-file
#
# Called after successful panel authentication, including IP and 2FA checks.
# PASSWORD may be transmitted via a temporary file, as in v-check-user-password.

# Argument definition
user=$1
password=$2
HIDE=2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER PASSWORD'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Missing or unrecognized policy values must not enable password migration.
if [ "$POLICY_SYSTEM_UPGRADE_MD5" != 'yes' ]; then
	exit 0
fi

shadow=$(awk -F : -v user="$user" '$1 == user {print $2}' /etc/shadow)
check_result "$?" "could not read password hash"
# Do not modify modern, locked, empty, or malformed hashes.
if [[ ! "$shadow" =~ ^\$1\$[./0-9A-Za-z]{1,8}\$[./0-9A-Za-z]{22}$ ]]; then
	exit 0
fi

is_password_valid
if [ -z "$password" ] || [[ "$password" == *$'\n'* || "$password" == *$'\r'* ]]; then
	check_result "$E_PASSWORD" "password mismatch"
fi

# Recheck the plaintext password here: possession of a legacy hash is not
# sufficient to choose the password used for its replacement.
salt=$(echo "$shadow" | cut -f 3 -d '$')
hash=$("$BIN/v-generate-password-hash" md5 "$salt" <<< "$password")
check_result "$?" "could not verify legacy password"
if [ "$hash" != "$shadow" ]; then
	check_result "$E_PASSWORD" "password mismatch"
fi

check_hestia_demo_mode

# Use the system's memory-hard yescrypt implementation and a fresh random salt.
# Do not fall back to MD5/DES, or apply password-quality rules to an unchanged
# password. No plaintext password is passed in the process arguments.
hash=$(mkpasswd --method=yescrypt --stdin <<< "$password")
check_result "$?" "could not generate yescrypt password hash"
if [[ ! "$hash" =~ ^\$y\$[./0-9A-Za-z]+\$[./0-9A-Za-z]+\$[./0-9A-Za-z]+$ ]]; then
	check_result "$E_PASSWORD" "could not generate yescrypt password hash"
fi

# Avoid overwriting a password changed while the new hash was being generated.
current_shadow=$(awk -F : -v user="$user" '$1 == user {print $2}' /etc/shadow)
check_result "$?" "could not read password hash"
if [ "$current_shadow" != "$shadow" ]; then
	check_result "$E_PASSWORD" "password changed during hash upgrade"
fi

# usermod preserves password ageing, unlike changing the password via chpasswd.
/usr/sbin/usermod --password "$hash" "$user"
check_result "$?" "could not upgrade password hash"

update_user_value "$user" '$MD5' "$hash"
check_result "$?" "could not synchronize password hash"
update_user_value "$user" '$RKEY' "$(generate_password)"
check_result "$?" "could not invalidate password reset token"

"$BIN/v-log-action" "system" "Info" "Security" "Password hash upgraded to yescrypt (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit 0
