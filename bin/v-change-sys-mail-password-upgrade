#!/bin/bash
# info: enable or disable Dovecot MD5-crypt password migration
# options: ENABLE
#
# example: v-change-sys-mail-password-upgrade yes

enable=$1

# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'ENABLE'
is_boolean_format_valid "$enable" 'enable'
check_hestia_demo_mode
if [ "$IMAP_SYSTEM" != 'dovecot' ] || [ "$MAIL_SYSTEM" = 'remote' ]; then
	check_result "$E_DISABLED" "local Dovecot is required"
fi

auth_conf='/etc/dovecot/conf.d/auth-passwdfile.conf.ext'
upgrade_conf='/etc/dovecot/conf.d/auth-hestia-password-upgrade.conf.ext'
include_line="!include_try $upgrade_conf"
unit_dir='/etc/systemd/system/dovecot.service.d'
unit_conf="$unit_dir/hestia-password-upgrade.conf"
unit_template="$HESTIA/install/common/dovecot/password-upgrade.service.conf"
require_file() {
	if [ ! -f "$1" ]; then
		check_result "$E_NOTEXIST" "required file does not exist: $1"
	fi
}
require_file "$auth_conf"

if [ "$enable" = 'yes' ]; then
	version=$(dovecot --version | cut -d . -f 1,2)
	if [[ "$version" != '2.3' && "$version" != '2.4' ]]; then
		check_result "$E_INVALID" "Dovecot 2.3 or 2.4 is required"
	fi
	# --build-options does not list Lua, including on builds with Lua support.
	# Look for the loadable driver, or the verification entry point embedded
	# in the auth executable on distributions which link the driver directly.
	module_dir=$(doveconf -h mail_plugin_dir)
	check_result "$?" "could not locate Dovecot authentication modules"
	if [ -z "$module_dir" ] || [ ! -r "$module_dir/auth/libauthdb_lua.so" ]; then
		libexec_dir=$(doveconf -h libexec_dir)
		check_result "$?" "could not locate Dovecot authentication executable"
		if [ -z "$libexec_dir" ] || ! grep -aqF 'auth_password_verify' "$libexec_dir/auth" 2> /dev/null; then
			check_result "$E_DISABLED" "Dovecot Lua passdb support is required (install dovecot-auth-lua where available)"
		fi
	fi
	require_file "$HESTIA/install/common/dovecot/$version/auth-password-upgrade.conf.ext"
	require_file "$HESTIA/func/dovecot-password-upgrade.lua"
	require_file "$HESTIA/func/dovecot-password-upgrade.php"
	require_file "$unit_template"
	require_file "$HESTIA_PHP"
	if ! "$HESTIA_PHP" -r 'exit(PHP_VERSION_ID >= 80100 && function_exists("fsync") && function_exists("proc_open") ? 0 : 1);'; then
		check_result "$E_DISABLED" "Hestia PHP 8.1+ with fsync and proc_open is required"
	fi
	if ! "$HESTIA_PHP" -l "$HESTIA/func/dovecot-password-upgrade.php" > /dev/null; then
		check_result "$E_PARSING" "mail password upgrade helper validation failed"
	fi
fi

# Serialize configuration changes; credentials are never handled by this command.
exec {lock_fd}> "$HESTIA/conf/mail-password-upgrade.lock"
check_result "$?" "could not lock mail password upgrade configuration"
flock -w 10 "$lock_fd"
check_result "$?" "mail password upgrade configuration is busy"
source_conf "$HESTIA/conf/hestia.conf"
old_policy=${POLICY_MAIL_UPGRADE_MD5:-no}

workdir=$(mktemp -d)
check_result "$?" "could not create configuration backup"
trap 'rm -f "$workdir/auth" "$workdir/upgrade" "$workdir/unit"; rmdir "$workdir"' EXIT
cp -p "$auth_conf" "$workdir/auth"
check_result "$?" "could not back up Dovecot authentication configuration"
if [ -e "$upgrade_conf" ]; then
	cp -p "$upgrade_conf" "$workdir/upgrade"
	check_result "$?" "could not back up Dovecot password upgrade configuration"
fi
if [ -e "$unit_conf" ]; then
	cp -p "$unit_conf" "$workdir/unit"
	check_result "$?" "could not back up Dovecot systemd configuration"
fi

restore_config() {
	cp -p "$workdir/auth" "$auth_conf"
	if [ -e "$workdir/upgrade" ]; then
		cp -p "$workdir/upgrade" "$upgrade_conf"
	else
		rm -f "$upgrade_conf"
	fi
	if [ -e "$workdir/unit" ]; then
		cp -p "$workdir/unit" "$unit_conf"
	else
		rm -f "$unit_conf"
	fi
}

if [ "$enable" = 'yes' ]; then
	if ! grep -qxF "$include_line" "$auth_conf"; then
		sed -i "1i$include_line" "$auth_conf"
		if [ $? -ne 0 ]; then
			restore_config
			check_result "$E_PARSING" "could not configure Dovecot password upgrade"
		fi
	fi
	install -m 0644 "$HESTIA/install/common/dovecot/$version/auth-password-upgrade.conf.ext" "$upgrade_conf"
	if [ $? -ne 0 ]; then
		restore_config
		check_result "$E_PARSING" "could not configure Dovecot password upgrade"
	fi
	# Debian's ProtectSystem=full makes /usr read-only even to root workers.
	# Do not weaken it globally: permit only the metadata and stable gate.
	if ! install -d -m 0755 "$unit_dir" || ! install -m 0644 "$unit_template" "$unit_conf"; then
		restore_config
		check_result "$E_PARSING" "could not configure Dovecot systemd write access"
	fi
else
	rm -f "$upgrade_conf" "$unit_conf"
	if [ $? -ne 0 ]; then
		restore_config
		check_result "$E_PARSING" "could not disable Dovecot password upgrade"
	fi
fi

# Reject invalid configuration before touching the running service.
if ! doveconf -n > /dev/null; then
	restore_config
	check_result "$E_PARSING" "Dovecot configuration validation failed"
fi

"$BIN/v-change-sys-config-value" POLICY_MAIL_UPGRADE_MD5 "$enable"
if [ $? -ne 0 ]; then
	restore_config
	"$BIN/v-change-sys-config-value" POLICY_MAIL_UPGRADE_MD5 "$old_policy"
	check_result "$E_PARSING" "could not save mail password upgrade policy"
fi
# A reload cannot change the running service's mount namespace. Both adding
# and removing the narrow write exception require a daemon reload and restart.
if ! systemctl daemon-reload; then
	restore_config
	"$BIN/v-change-sys-config-value" POLICY_MAIL_UPGRADE_MD5 "$old_policy"
	systemctl daemon-reload
	check_result "$E_RESTART" "could not reload Dovecot systemd configuration; restored previous policy"
fi
systemctl restart dovecot
if [ $? -ne 0 ]; then
	restore_config
	"$BIN/v-change-sys-config-value" POLICY_MAIL_UPGRADE_MD5 "$old_policy"
	systemctl daemon-reload
	systemctl restart dovecot
	check_result "$E_RESTART" "could not apply Dovecot configuration; attempted to restore previous policy"
fi

"$BIN/v-log-action" system Info Mail "Mail password hash upgrade policy changed (Value: $enable)."
log_event "$OK" "$ARGUMENTS"
exit 0
