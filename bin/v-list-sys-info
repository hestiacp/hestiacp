#!/bin/bash
# info: list system os
# options: [FORMAT]
#
# example: v-list-sys-info
#
# This function checks available updates for hestia packages.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Retrieve Hestia Control Panel version number
HESTIA_VERSION=$(grep VERSION $HESTIA/conf/hestia.conf | cut -d '=' -f2 | sed "s|'||g")
HESTIA_RELEASE=$(grep RELEASE_BRANCH $HESTIA/conf/hestia.conf | cut -d '=' -f2 | sed "s|'||g")

# JSON list function
json_list() {
	echo '{'
	echo '    "sysinfo": {
        "HOSTNAME": "'$HOSTNAME'",
        "OS": "'$OS'",
        "VERSION": "'$VERSION'",
        "ARCH": "'$ARCH'",
        "HESTIA": "'$HESTIA_VERSION'",
        "RELEASE": "'$HESTIA_RELEASE'",
        "UPTIME": "'$UPTIME'",
        "LOADAVERAGE": "'$LOADAVERAGE'"
        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "HOSTNAME   OS   VER   ARCH  HESTIA  RELEASE  UPTIME   LA"
	echo "--------   --   ---   ----  ------  -------  ------   --"
	echo "$HOSTNAME $OS $VERSION $ARCH $HESTIA_VERSION $HESTIA_RELEASE $UPTIME $LOADAVERAGE"
}

# PLAIN list function
plain_list() {
	echo -e "$HOSTNAME\t$OS\t$VERSION\t$ARCH\t$HESTIA_VERSION\t$HESTIA_RELEASE\t$UPTIME\t$LOADAVERAGE"
}

# CSV list function
csv_list() {
	echo "HOSTNAME,OS,VERSION,ARCH,HESTIA,RELEASE,UPTIME,LOADAVERAGE"
	echo "$HOSTNAME,$OS,$VERSION,$ARCH,$HESTIA_VERSION,$HESTIA_RELEASE,$UPTIME,$LOADAVERAGE"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Check hostname
HOSTNAME=$(hostname)

# Check OS/Release
os_id=""
if [ -r '/etc/os-release' ]; then
	os_id=$(grep -m1 '^ID=' /etc/os-release | cut -f 2 -d '=' | tr -d '"' | tr '[:upper:]' '[:lower:]')
fi

if { [ "$os_id" = 'ubuntu' ] || [ "$(lsb_release -si 2> /dev/null)" = "Ubuntu" ]; } && [ -e '/etc/debian_version' ]; then
	OS="Ubuntu"
	if [ -r '/etc/lsb-release' ]; then
		VERSION=$(grep -m1 '^DISTRIB_RELEASE=' /etc/lsb-release | cut -f 2 -d '=')
	fi
	if [ -z "$VERSION" ] && [ -r '/etc/os-release' ]; then
		VERSION=$(grep -m1 '^VERSION_ID=' /etc/os-release | cut -f 2 -d '=' | tr -d '"')
	fi
elif [ "$os_id" = 'debian' ] || [ "$(head -n1 /etc/issue 2> /dev/null | cut -f 1 -d ' ')" = 'Debian' ]; then
	OS="Debian"
	if [ -r '/etc/debian_version' ]; then
		VERSION=$(cat /etc/debian_version)
	elif [ -r '/etc/os-release' ]; then
		VERSION=$(grep -m1 '^VERSION_ID=' /etc/os-release | cut -f 2 -d '=' | tr -d '"')
	fi
else
	OS='UNKNOWN'
	VERSION='UNKNOWN'
fi

# Check architecture
ARCH=$(arch)

# Check uptime
UPTIME=$(cat /proc/uptime | cut -f 1 -d ' ' | cut -f 1 -d .)
UPTIME="$(echo $UPTIME / 60 | bc)"

# Check LoadAverage
LOADAVERAGE=$(cat /proc/loadavg | cut -f 1-3 -d ' ' | sed 's/ / \/ /g')

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
