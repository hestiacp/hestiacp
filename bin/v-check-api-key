#!/bin/bash
# info: check api key
# options: KEY [IP]
#
# example: v-check-api-key random_key 127.0.0.1
#
# This function checks a key file in $HESTIA/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
password="$1"
HIDE=1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Byte semantics for the key name check, independent of the system locale
LC_ALL=C

new_timestamp

abort_missmatch() {
	echo "Error: key missmatch"
	echo "$date $time api $ip failed to login" >> $HESTIA/log/auth.log
	# Hardcoded E_PASSWORD: a rejected key must never exit with 0, even if
	# func/main.sh could not be sourced.
	exit 9
}

ip=${2-127.0.0.1}
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# If key is set as tmp file it will be read from there
is_password_valid

#password is now set with the value of api key
key="$(basename "$password")"

# Exit if Key is unset or to short
[[ -z $key || ${#key} -lt 16 ]] && abort_missmatch

# Key name must only contain safe characters
[[ $key =~ ^[A-Za-z0-9_.-]{16,128}$ ]] || abort_missmatch

# Key file must exist and be a regular file, not a symlink
key_path="${HESTIA}/data/keys/${key}"
[[ -L $key_path ]] && abort_missmatch
[[ -f $key_path ]] || abort_missmatch

# Resolve the path and make sure it stays inside the key store
maybe_key_path="$(readlink -e "${HESTIA}/data/keys/${key}")"
[[ -z $maybe_key_path ]] && abort_missmatch

# Key file cannot be the key store
[[ $maybe_key_path == "${HESTIA}/data/keys" ]] && abort_missmatch

# Key file must be in the key store
[[ $maybe_key_path == "${HESTIA}/data/keys/"* ]] || abort_missmatch

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

echo "$date $time api $ip successfully launched" >> $HESTIA/log/auth.log

exit
