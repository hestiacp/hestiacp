#!/bin/bash
# info: change DNS domain description
# options: USER DOMAIN [DESCRIPTION]
#
# example: v-change-dns-domain-description admin example.com 'Legacy website, do not remove until migration is done'
#
# This function changes the description of a DNS domain.
# The description is a single line of free text (max 255 characters) and has no
# effect on the service configuration. Omit DESCRIPTION to clear it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
description=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [DESCRIPTION]'
is_format_valid 'user' 'domain' 'description'
is_system_enabled "$DNS_SYSTEM" 'DNS_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'dns' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Apostrophes are stored as %quote%
description=$(encode_description "$description")

# Add the DESCRIPTION key to objects created before descriptions were supported
add_object_key 'dns' 'DOMAIN' "$domain" 'DESCRIPTION' 'SUSPENDED'

# Changing description
update_object_value 'dns' 'DOMAIN' "$domain" '$DESCRIPTION' "$description"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "DNS" "DNS domain description updated (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit
