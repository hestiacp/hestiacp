#!/usr/bin/env bats
#
# Test for the Roundcube vendor/ marker repair in v-add-sys-roundcube.
# Roundcube's installto.sh only replaces vendor/ when vendor/autoload.php
# carries a "generated by Roundcube" marker. Composer removes that marker
# whenever it regenerates the autoloader, so a vendor/ update by
# update_rc_modules() makes the next upgrade look like a Composer-managed
# install and skips vendor/ (hestiacp#5997).
#
# Restoring the marker makes installto.sh rsync --delete the release vendor/
# over the installed one, so most of these cases assert that the marker is
# NOT restored: anything the release does not ship would be deleted.

load '../test_helper/bats-support/load'
load '../test_helper/bats-assert/load'

setup() {
    # The marker is appended as the webmail user, so these tests need root and
    # that user. The CI container runs as root and creates hestiamail.
    if [[ "$(id -u)" != "0" ]] || ! id hestiamail > /dev/null 2>&1; then
        skip "needs root and the hestiamail user"
    fi

    HESTIA="${HESTIA:-/usr/local/hestia}"
    workdir=$(mktemp -d)
    install_dir="${workdir}/roundcube"
    mkdir -p "${install_dir}/vendor/composer" \
        "${install_dir}/program/include" \
        "${install_dir}/roundcubemail-1.7.6"

    printf "define('RCMAIL_VERSION', '1.7.5');\n" > "${install_dir}/program/include/iniset.php"

    # The extracted release: composer.lock is what the guard compares against,
    # and vendor/ is the tree installto.sh rsyncs over the installed one
    cat > "${install_dir}/roundcubemail-1.7.6/composer.lock" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "symfony/polyfill-php84" }
    ]
}
EOF
    mkdir -p "${install_dir}/roundcubemail-1.7.6/vendor/bacon/bacon-qr-code"
    printf '<?php\n' > "${install_dir}/roundcubemail-1.7.6/vendor/autoload.php"
    printf '<?php\n' > "${install_dir}/roundcubemail-1.7.6/vendor/bacon/bacon-qr-code/BaconQrCode.php"

    # A package-managed install: Roundcube's composer.json, and a vendor/ that
    # holds one of the packages the release ships
    cat > "${install_dir}/composer.json" <<'EOF'
{
    "name": "roundcube/roundcubemail",
    "require": {
        "php": ">=8.1",
        "bacon/bacon-qr-code": "^3.0.0"
    }
}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" }
    ]
}
EOF
    mkdir -p "${install_dir}/vendor/bacon/bacon-qr-code"
    printf '<?php\n' > "${install_dir}/vendor/bacon/bacon-qr-code/BaconQrCode.php"

    # vendor/autoload.php as Composer rewrites it, i.e. without the marker
    printf '<?php\n\nreturn ComposerAutoloaderInit123::getLoader();\n' > "${install_dir}/vendor/autoload.php"

    # The real tree is owned by the webmail user, and the marker is written as
    # that user, so the fixture has to match or the write is refused. The
    # parent must be traversable too: /var/lib/roundcube is, but mktemp's 0700
    # directory is not.
    if id hestiamail > /dev/null 2>&1; then
        chmod 755 "${workdir}"
        chown -R hestiamail:www-data "${install_dir}/vendor"
    fi

    # Pull the function under test out of the real script
    sed -n '/^restore_vendor_marker() {/,/^}$/p' \
        "${HESTIA}/bin/v-add-sys-roundcube" > "${workdir}/func.sh"

    export RC_INSTALL_DIR="${install_dir}"
    export RC_EXTRACT="roundcubemail-1.7.6"
    export PHP_CLI="/usr/bin/php"
    export rc_v="1.7.6"
}

teardown() {
    rm -rf "${workdir}"
}

run_restore() {
    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker"
    assert_success
}

marker_count() {
    grep -c "generated by Roundcube" "${install_dir}/vendor/autoload.php" || true
}

@test "Roundcube: vendor marker is restored for a package-managed install" {
    run_restore
    assert_equal "$(marker_count)" "1"
    run grep -q "generated by Roundcube install 1.7.5" "${install_dir}/vendor/autoload.php"
    assert_success
}

@test "Roundcube: vendor marker is restored when the caller chowns the tree first" {
    # installto.sh and composer run as root, so the tree can be root-owned when
    # this runs. Both call sites chown -R before calling, and the write then
    # happens as hestiamail.
    chown -R root:root "${install_dir}/vendor"
    chown -R hestiamail:www-data "${install_dir}/vendor"

    run_restore
    assert_equal "$(marker_count)" "1"
}

@test "Roundcube: vendor marker is not restored when the file is not hestiamail's" {
    # The function must never chown the file itself: that would let a swapped
    # path hand a root-owned file to the webmail user.
    chown -R root:root "${install_dir}/vendor"

    run_restore
    assert_equal "$(marker_count)" "0"
    run stat -c %U "${install_dir}/vendor/autoload.php"
    assert_output "root"
}

@test "Roundcube: vendor marker is not restored when the install has extra requirements" {
    # A plugin installed with Composer must keep its vendor/ untouched
    cat > "${install_dir}/composer.json" <<'EOF'
{
    "name": "roundcube/roundcubemail",
    "require": {
        "php": ">=8.1",
        "mstilkerich/rcmcarddav": "^5.0"
    }
}
EOF
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "mstilkerich/rcmcarddav" }
    ]
}
EOF
    mkdir -p "${install_dir}/vendor/mstilkerich/rcmcarddav"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored for a plugin directory no package accounts for" {
    # Files placed in vendor/ by hand are not in installed.json
    mkdir -p "${install_dir}/vendor/acme/customplugin"
    printf '<?php\n' > "${install_dir}/vendor/acme/customplugin/Plugin.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored for a file at the top of vendor/" {
    printf '<?php\n' > "${install_dir}/vendor/singlefile.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is restored when a package is a newer version than the release" {
    # update_rc_modules() runs composer update, so a shipped package can hold
    # files the release tarball does not have. That must not block the repair.
    mkdir -p "${install_dir}/vendor/nette/utils/src/Utils"
    printf '<?php\n' > "${install_dir}/vendor/nette/utils/src/Utils/DateTimeImmutable.php"
    cat > "${install_dir}/vendor/composer/installed.json" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "nette/utils" }
    ]
}
EOF
    cat > "${install_dir}/roundcubemail-1.7.6/composer.lock" <<'EOF'
{
    "packages": [
        { "name": "bacon/bacon-qr-code" },
        { "name": "nette/utils" }
    ]
}
EOF

    run_restore
    assert_equal "$(marker_count)" "1"
}

@test "Roundcube: vendor marker is not restored for a dot directory in vendor/" {
    mkdir -p "${install_dir}/vendor/.evil"
    printf '<?php\n' > "${install_dir}/vendor/.evil/x.php"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when composer.json is truncated" {
    # A failed edit or composer run leaves valid but empty JSON
    printf '{}\n' > "${install_dir}/composer.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: a refusal says which file or package caused it" {
    # The upgrade log is the only place an admin sees why the repair was
    # skipped, so a silent exit is not good enough.
    printf '{}\n' > "${install_dir}/composer.json"

    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker 2>&1"
    assert_output --partial "composer.json is not a Roundcube composer.json"
}

@test "Roundcube: malformed JSON reports the parse error instead of failing silently" {
    printf 'not json\n' > "${install_dir}/composer.json"

    run bash -c "source '${workdir}/func.sh'; restore_vendor_marker 2>&1"
    assert_output --partial "JsonException"
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when composer.json is not Roundcube's" {
    printf '{ "require": {} }\n' > "${install_dir}/composer.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored when installed.json is unreadable" {
    printf 'not json\n' > "${install_dir}/vendor/composer/installed.json"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not restored without a release composer.lock" {
    rm -f "${install_dir}/roundcubemail-1.7.6/composer.lock"

    run_restore
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: vendor marker is not written through a symlink" {
    # vendor/ is owned by the webmail user, which could plant a link here
    local victim="${workdir}/victim"
    printf 'untouched\n' > "${victim}"
    rm -f "${install_dir}/vendor/autoload.php"
    ln -s "${victim}" "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(cat "${victim}")" "untouched"
}

@test "Roundcube: vendor marker is not written through a hardlink" {
    local victim="${workdir}/victim"
    printf 'untouched\n' > "${victim}"
    rm -f "${install_dir}/vendor/autoload.php"
    ln "${victim}" "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(cat "${victim}")" "untouched"
    assert_equal "$(marker_count)" "0"
}

@test "Roundcube: no temporary file is left behind in vendor/" {
    run_restore
    assert_equal "$(marker_count)" "1"
    run bash -c "ls -a '${install_dir}/vendor' | grep -c '^\\.autoload' || true"
    assert_output "0"
}

@test "Roundcube: vendor marker is left alone when it is already present" {
    printf '// generated by Roundcube install 1.7.5\n' >> "${install_dir}/vendor/autoload.php"
    local sha_before
    sha_before=$(sha256sum "${install_dir}/vendor/autoload.php" | cut -d" " -f1)

    run_restore
    assert_equal "$(sha256sum "${install_dir}/vendor/autoload.php" | cut -d" " -f1)" "${sha_before}"
}

@test "Roundcube: restored marker keeps the file valid PHP without a trailing newline" {
    printf '<?php\n\nreturn ComposerAutoloaderInit123::getLoader();' > "${install_dir}/vendor/autoload.php"

    run_restore
    assert_equal "$(marker_count)" "1"
    run "${PHP_CLI}" -l "${install_dir}/vendor/autoload.php"
    assert_success
}
