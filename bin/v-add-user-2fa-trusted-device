#!/bin/bash
# info: add trusted device for user 2fa
# options: USER HASH
#
# example: v-add-user-2fa-trusted-device admin 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
#
# This function stores the SHA-256 hash of a trusted device token, so the
# device can skip the 2FA token prompt for TWOFA_TRUSTED_DEVICE_DAYS days.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
hash=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER HASH'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if ! [[ "$hash" =~ ^[0-9a-f]{64}$ ]]; then
	check_result "$E_INVALID" "invalid hash format :: $hash"
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

source $USER_DATA/user.conf
if [ -z "$TWOFA" ]; then
	echo "Error: Two-factor authentication is not enabled."
	exit "$E_NOTEXIST"
fi

days="${TWOFA_TRUSTED_DEVICE_DAYS:-0}"
if ! [[ "$days" =~ ^[0-9]{1,3}$ ]] || [ $((10#$days)) -eq 0 ]; then
	echo "Error: Trusted devices for 2FA are disabled."
	exit "$E_DISABLED"
fi
days=$((10#$days))

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Serialize changes to the trusted devices of this user (root-only lock file)
old_umask=$(umask)
umask 077
exec 9> "/run/hestia-2fa-trusted-$user.lock"
check_result $? "Unable to create trusted devices lock file"
umask "$old_umask"
flock -w 30 9
check_result $? "Unable to acquire trusted devices lock"

conf="$USER_DATA/2fa-trusted-devices.conf"
now=$(date +%s)
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Drop expired entries and keep at most 19 others
tmp=$(mktemp -p "$USER_DATA")
check_result $? "Unable to create temporary file"
if [ -f "$conf" ]; then
	while read -r line; do
		created=$(echo "$line" | sed -n "s/.*CREATED='\([0-9]*\)'.*/\1/p")
		if [ -n "$created" ] && [ $((created + days * 86400)) -gt "$now" ]; then
			echo "$line"
		fi
	done < "$conf" | tail -n 19 > "$tmp"
fi
echo "HASH='$hash' CREATED='$now' TIME='$time' DATE='$date'" >> "$tmp"
tail -n 1 "$tmp" | grep -qF "HASH='$hash' " && chmod 640 "$tmp" && mv -f "$tmp" "$conf"
if [ $? -ne 0 ]; then
	rm -f "$tmp"
	check_result "$E_DISK" "Unable to save trusted device"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Security" "Device trusted for two-factor authentication ($days days)."
log_event "$OK" "$ARGUMENTS"

exit
