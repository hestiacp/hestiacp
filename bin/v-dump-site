#!/bin/bash
# info: Dumps the files of a site into a zip archive
# options: USER DOMAIN [TYPE]
#
# example: v-dump-site user domain
# example: v-dump-site user domain full
#
# Dumps site files in /backup/user.domain.timestamp.zip

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
type=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Create timestamp in Y-M-D_h-m-s format
timestamp=$(date +'%G-%m-%d_%H-%M-%S')

if [ "$type" = "full" ]; then
	site_dir="$HOMEDIR/$user/web/$domain"
else
	site_dir="$HOMEDIR/$user/web/$domain/public_html"
fi

zip_file="$BACKUP/${user}_${domain}_${timestamp}.zip"

# The whole web directory tree is under the user's control: public_html is
# inside the user owned domain directory, and the root owned web directory
# sits in the user owned home, so the user can rename it and put a symlink in
# its place. Any root process walking that tree (cd, zip, ...) can therefore be
# sent anywhere on the server, and checking the path first is open to races.
# So the archiver runs with the user's privileges: whatever the tree points
# at, it can only read what the user can already read. Only the finished
# archive, streamed on stdout, is written by root into the root owned $BACKUP.
# -y stores symbolic links as links instead of following them.
user_exec bash -c 'cd -P -- "$1" && exec zip -rqy - .' bash "$site_dir" > "$zip_file"
zip_rc=$?

# 0: OK, 18: some files could not be read by the user and were skipped
if [ "$zip_rc" -ne 0 ] && [ "$zip_rc" -ne 18 ]; then
	rm -f -- "$zip_file"
	check_result "$E_NOTEXIST" "Unable to create an archive of $site_dir"
fi

if [[ -f "$BACKUP/${user}_${domain}_${timestamp}.zip" ]]; then
	# echo filename for use in the php
	echo "${user}_${domain}_${timestamp}.zip"

	# echo file location for use in the php
	echo "$BACKUP/${user}_${domain}_${timestamp}.zip"

	# cleanup
	echo "rm $BACKUP/${user}_${domain}_${timestamp}.zip" | at now + 1 hour
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
