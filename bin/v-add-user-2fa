#!/bin/bash
# info: activate 2fa for a user after verifying a token
# options: USER SECRET TOKEN [DEVICE_NAME]
#
# example: v-add-user-2fa admin JBSWY3DPEHPK3PXP 123456 'iPhone'
#
# This function activates 2FA for a user. SECRET must be a secret
# previously generated by v-generate-user-2fa-secret, and TOKEN must be a
# currently valid TOTP token generated from that secret - this proves the
# user's authenticator app is correctly configured before 2FA is enabled.
# DEVICE_NAME is an optional free-text label shown back to the user later.
# On success, a new set of single-use backup codes is generated and printed.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
twofa_secret=$2
twofa_token=$3
device_name=$4

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SECRET TOKEN [DEVICE_NAME]'
is_format_valid 'user' 'system' 'twofa_secret' 'twofa_token' 'device_name'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Reading user values
source $USER_DATA/user.conf

# Check if 2FA is already enabled
if [ -n "$TWOFA" ]; then
	echo "Error: 2FA already enabled"
	exit "$E_EXISTS"
fi

# Verify the token against the provided secret before persisting anything
result=$($HESTIA_PHP $HESTIA/web/inc/2fa/check.php "$twofa_secret" "$twofa_token")
if [ "$result" != "ok" ]; then
	echo "Error: Authentication token mismatch."
	exit "$E_PASSWORD"
fi

# Re-derive the qr code from the verified secret (never trust a client-supplied one)
mapfile -t twofa_data < <($HESTIA_PHP $HESTIA/web/inc/2fa/secret.php "$twofa_secret")
qrcode="${twofa_data[1]}"

# Generate single-use backup codes
backup_codes=()
while [ "${#backup_codes[@]}" -lt 10 ]; do
	code=$(generate_password 'A-Z0-9' 10)
	if [ "${#code}" -eq 10 ]; then
		backup_codes+=("$code")
	fi
done
backup_list=$(
	IFS=,
	echo "${backup_codes[*]}"
)

# Save the secret and backup codes in user config
update_user_value "$user" '$TWOFA' "$twofa_secret"
update_user_value "$user" '$QRCODE' "$qrcode"
update_user_value "$user" '$TWOFA_BACKUP' "$backup_list"
if [ -n "$device_name" ]; then
	update_user_value "$user" '$TWOFA_DEVICE_NAME' "$device_name"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "System" "Two-factor authentication enabled (User: $user)."
$BIN/v-log-action "$user" "Warning" "System" "Two-factor authentication enabled."

printf '%s\n' "${backup_codes[@]}"

exit
