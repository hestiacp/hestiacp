#!/bin/bash
# info: backup system user with all its objects to restic backup
# options: USER NOTIFY
#
# example: v-backup-user-restic admin yes
#
# Backup user with all its objects to restic backup. If the repo doesn't exists a new one will be created.
#

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
# Argument definition
user=$1
notify=${2-no}
# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# shellcheck source=/usr/local/hestia/func/db.sh
source $HESTIA/func/db.sh
# shellcheck source=/usr/local/hestia/func/backup.sh
source $HESTIA/func/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

escape_restic_glob() {
	escaped_glob="$1"
	escaped_glob="${escaped_glob//\\/\\\\}"
	escaped_glob="${escaped_glob//\*/\\*}"
	escaped_glob="${escaped_glob//\?/\\?}"
	escaped_glob="${escaped_glob//\[/\\[}"
	escaped_glob="${escaped_glob//\]/\\]}"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_incremental_backup_enabled

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Set notification email and subject
subj="$user → backup failed"
email=$(grep CONTACT "$HESTIA/data/users/$ROOT_USER/user.conf" | cut -f 2 -d \')

source_conf $HESTIA/conf/restic.conf

if [ ! -f "$USER_DATA/restic.conf" ]; then
	password=$(generate_password '' '32')
	echo "$password" > $USER_DATA/restic.conf

	restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf init
	if [ $? -ne 0 ]; then
		check_result $E_CONNECT "Unable to create restic repo"
	fi
else
	# Check if repo exists and is accessible with restic key
	restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf --json snapshots > /dev/null
	if [ $? -ne 0 ]; then
		# Send an email
		echo "Unable to open restic backup. It might not exists or key is incorrect" | $SENDMAIL -s "$subj" "$email" "yes"
		check_result $E_CONNECT "Unable to access restic repo"
	fi
fi

# create backup of the user.conf an database
$BIN/v-backup-user-config $user

restic_excludes=()
if [ -f "$USER_DATA/backup-excludes.conf" ] && [ ! -L "$USER_DATA/backup-excludes.conf" ]; then
	# Preserve the exported USER environment variable when sourcing backup-excludes.conf,
	# because its USER= key would otherwise inherit USER=root or overwrite USER for child processes.
	orig_env_user="${USER-}"
	orig_env_user_set="${USER+yes}"
	WEB=''
	MAIL=''
	USER=''
	source_conf "$USER_DATA/backup-excludes.conf"
	web_excl="$WEB"
	mail_excl="$MAIL"
	user_excl="$USER"
	if [ "$orig_env_user_set" = "yes" ]; then
		USER="$orig_env_user"
	else
		unset USER
	fi

	if [ "$web_excl" = '*' ]; then
		restic_excludes+=(--exclude "/home/$user/web/*")
	elif [ -n "$web_excl" ]; then
		IFS=',' read -ra web_entries <<< "$web_excl"
		for entry in "${web_entries[@]}"; do
			[ -z "$entry" ] && continue
			IFS=':' read -ra parts <<< "$entry"
			domain_part="${parts[0]}"
			[ -z "$domain_part" ] && continue
			if [ "$domain_part" = '*' ]; then
				domain_escaped='*'
			else
				escape_restic_glob "$domain_part"
				domain_escaped="$escaped_glob"
			fi
			if [ "${#parts[@]}" -eq 1 ]; then
				restic_excludes+=(--exclude "/home/$user/web/$domain_escaped")
			else
				for ((i = 1; i < ${#parts[@]}; i++)); do
					seg="${parts[$i]#/}"
					seg="${seg%/}"
					if [ -n "$seg" ]; then
						escape_restic_glob "$seg"
						restic_excludes+=(--exclude "/home/$user/web/$domain_escaped/$escaped_glob")
					fi
				done
			fi
		done
	fi

	if [ "$mail_excl" = '*' ]; then
		restic_excludes+=(--exclude "/home/$user/mail/*")
	elif [ -n "$mail_excl" ]; then
		IFS=',' read -ra mail_entries <<< "$mail_excl"
		for entry in "${mail_entries[@]}"; do
			[ -z "$entry" ] && continue
			IFS=':' read -ra parts <<< "$entry"
			domain_part="${parts[0]}"
			[ -z "$domain_part" ] && continue
			if [ "$domain_part" = '*' ]; then
				domain_escaped='*'
			else
				domain_idn="$domain_part"
				format_domain_idn
				domain_part="$domain_idn"
				escape_restic_glob "$domain_part"
				domain_escaped="$escaped_glob"
			fi
			if [ "${#parts[@]}" -eq 1 ]; then
				restic_excludes+=(--exclude "/home/$user/mail/$domain_escaped")
			else
				for ((i = 1; i < ${#parts[@]}; i++)); do
					seg="${parts[$i]#/}"
					seg="${seg%/}"
					if [ -n "$seg" ]; then
						escape_restic_glob "$seg"
						restic_excludes+=(--exclude "/home/$user/mail/$domain_escaped/$escaped_glob")
					fi
				done
			fi
		done
	fi

	user_wildcard=0
	IFS=',' read -ra user_entries <<< "$user_excl"
	for xpath in "${user_entries[@]}"; do
		if [ "$xpath" = '*' ]; then
			user_wildcard=1
			break
		fi
	done

	if [ "$user_excl" = '*' ] || [ "$user_wildcard" -eq 1 ]; then
		had_nullglob=0
		had_dotglob=0
		shopt -q nullglob && had_nullglob=1
		shopt -q dotglob && had_dotglob=1
		shopt -s nullglob dotglob
		for uentry in "/home/$user"/*; do
			udir="${uentry#"/home/$user/"}"
			case "$udir" in
				'' | '.' | '..' | 'backup' | 'conf' | 'web' | 'dns' | 'tmp' | 'mail')
					continue
					;;
			esac
			escape_restic_glob "$udir"
			restic_excludes+=(--exclude "/home/$user/$escaped_glob")
		done
		[ "$had_nullglob" -eq 0 ] && shopt -u nullglob
		[ "$had_dotglob" -eq 0 ] && shopt -u dotglob
	elif [ -n "$user_excl" ]; then
		for xpath in "${user_entries[@]}"; do
			xpath="${xpath#/}"
			xpath="${xpath%/}"
			if [ -n "$xpath" ]; then
				escape_restic_glob "$xpath"
				restic_excludes+=(--exclude "/home/$user/$escaped_glob")
			fi
		done
	fi
fi

export GOMAXPROCS=2
export RESTIC_READ_CONCURRENCY=2
ionice -c2 -n7 nice -n 19 restic --repo "${REPO%/}/$user" --limit-upload 10240 --read-concurrency 2 --password-file $USER_DATA/restic.conf backup "${restic_excludes[@]}" /home/$user

if [ $? -ne 0 ]; then
	echo "Unable to create the backup" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result "$E_BACKUP" "Unable to backup user"
fi

if [[ -n "$SNAPSHOTS" && "$SNAPSHOTS" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-last $SNAPSHOTS"
fi
if [[ -n "$KEEP_DAILY" && "$KEEP_DAILY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-daily $KEEP_DAILY"
fi
if [[ -n "$KEEP_WEEKLY" && "$KEEP_WEEKLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-weekly $KEEP_WEEKLY"
fi
if [[ -n "$KEEP_MONTHLY" && "$KEEP_MONTHLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-monthly $KEEP_MONTHLY"
fi
if [[ -n "$KEEP_YEARLY" && "$KEEP_YEARLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-yearly $KEEP_YEARLY"
fi

restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf forget $restic_prune --prune

# Send notification
if [ -e "$BACKUP/$user.log" ] && [ "$notify" = "yes" ]; then
	subj="$user → backup has been completed"
	email=$(get_user_value '$CONTACT')
	cat $BACKUP/$user.log | $SENDMAIL -s "$subj" "$email" "$notify"
	$BIN/v-add-user-notification "$user" "Snapshot created successfully" "Snap shot of user successfully created"
fi

# Deleting task from queue
sed -i "/v-backup-user-restic $user /d" $HESTIA/data/queue/backup.pipe

# Logging
$BIN/v-log-action "$user" "Info" "Backup" "Backup created."
$BIN/v-log-action "system" "Info" "Backup" "Backup created (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
