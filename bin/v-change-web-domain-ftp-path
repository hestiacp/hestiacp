#!/bin/bash
# info: change path for ftp user.
# options: USER DOMAIN FTP_USER FTP_PATH
#
# example: v-change-web-domain-ftp-path admin example.com user_ftp /public_html
#
# This function changes ftp user path. FTP_PATH is relative to the domain
# web root ($HOMEDIR/$user/web/$domain).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
ftp_user=$3
ftp_path=$4

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER DOMAIN FTP_USER FTP_PATH'
is_format_valid 'user' 'domain' 'ftp_user' 'ftp_path'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'

# Load FTP users / paths into arrays (exact, literal comparison)
IFS=':' read -ra ftp_users <<< "$FTP_USER"
IFS=':' read -ra ftp_paths <<< "$FTP_PATH"

position=-1
for i in "${!ftp_users[@]}"; do
	if [[ "${ftp_users[$i]}" == "$ftp_user" ]]; then
		position=$i
		break
	fi
done

if ((position < 0)) || ! getent passwd -- "$ftp_user" > /dev/null; then
	echo "Error: account $ftp_user doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

# Resolve the domain base and the requested path, then make sure the
# result is the base itself or lives strictly under it (anchored, literal).
base=$(readlink -f -- "$HOMEDIR/$user/web/$domain")
if [ -z "$base" ]; then
	echo "Error: web root for $domain is invalid"
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi

ftp_path_a=$(readlink -f -- "$base/$ftp_path")
case "$ftp_path_a" in
	"$base" | "$base"/*) ;;
	*)
		echo "Error: absolute path $ftp_path_a is invalid"
		log_event "$E_INVALID" "$ARGUMENTS"
		exit "$E_INVALID"
		;;
esac

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# MKDIR if path doesn't exist
if [ ! -e "$ftp_path_a" ]; then
	mkdir -p -- "$ftp_path_a"

	# Re-check after creation (symlink race between check and mkdir)
	ftp_path_chk=$(readlink -f -- "$ftp_path_a")
	case "$ftp_path_chk" in
		"$base" | "$base"/*) ;;
		*)
			echo "Error: absolute path $ftp_path_chk is invalid"
			log_event "$E_INVALID" "$ARGUMENTS"
			exit "$E_INVALID"
			;;
	esac
	ftp_path_a="$ftp_path_chk"
	chown --no-dereference "$user:$user" -- "$ftp_path_a"
	chmod 751 -- "$ftp_path_a"
fi

# Changing ftp user path (edits only the home field, no sed on /etc/passwd)
if ! usermod -d "$ftp_path_a" -- "$ftp_user"; then
	echo "Error: could not change home directory for $ftp_user"
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi

# Updating chroot jail for SFTP and FTP
delete_chroot_jail "$ftp_user"
add_chroot_jail "$ftp_user"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Transforming absolute path to relative (literal prefix removal)
ftp_path_r="${ftp_path_a#"$base"}"

# Rebuilding FTP_PATH list, replacing only the entry at $position
ftp_path=""
for i in "${!ftp_users[@]}"; do
	if ((i == position)); then
		entry="$ftp_path_r"
	else
		entry="${ftp_paths[$i]-}"
	fi
	if ((i == 0)); then
		ftp_path="$entry"
	else
		ftp_path="$ftp_path:$entry"
	fi
done

# Updating config
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_PATH' "$ftp_path"

# Logging
$BIN/v-log-action "$user" "Info" "Web" "FTP account path changed (User: $ftp_user@$domain, Path: $ftp_path_a)."
log_event "$OK" "$ARGUMENTS"

exit
