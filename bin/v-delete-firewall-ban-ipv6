#!/bin/bash
# info: delete firewall blocking rule (IPv6)
# options: IPV6_CIDR CHAIN
#
# example: v-delete-firewall-ban-ipv6 2001:db8::bad MAIL
#
# This function deletes IPv6 blocking rule from system firewall. IPv6 bans are
# handled by v-delete-firewall-ban, this command is kept for the web interface.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ipv6_cidr=$1
chain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IPV6_CIDR CHAIN'
if [[ "$ipv6_cidr" != *:* ]]; then
	check_result "$E_INVALID" "invalid ipv6_cidr :: $ipv6_cidr"
fi
is_format_valid 'ipv6_cidr'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

exec "$BIN/v-delete-firewall-ban" "$ipv6_cidr" "$chain"
