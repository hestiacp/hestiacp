#!/bin/bash
# info: change database description
# options: USER DATABASE [DESCRIPTION]
#
# example: v-change-database-description admin admin_wordpress 'Legacy website, do not remove until migration is done'
#
# This function changes the description of a database.
# The description is a single line of free text (max 255 characters) and has no
# effect on the service configuration. Omit DESCRIPTION to clear it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
database=$2
description=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DATABASE [DESCRIPTION]'
is_format_valid 'user' 'database' 'description'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Apostrophes are stored as %quote%
description=$(encode_description "$description")

# Add the DESCRIPTION key to objects created before descriptions were supported
add_object_key 'db' 'DB' "$database" 'DESCRIPTION' 'SUSPENDED'

# Changing description
update_object_value 'db' 'DB' "$database" '$DESCRIPTION' "$description"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Database" "Database description updated (Database: $database)."
log_event "$OK" "$ARGUMENTS"

exit
