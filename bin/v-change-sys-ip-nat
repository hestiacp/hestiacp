#!/bin/bash
# info: change NAT IP address
# options: IP NAT_IP [RESTART]
#
# example: v-change-sys-ip-nat 10.0.0.1 203.0.113.1
#
# This function for changing NAT IP associated with IP.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip="$1"
nat_ip="$2"
restart="$3"

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/ip.sh
source $HESTIA/func/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP NAT_IP [RESTART]'
is_format_valid 'ip'
is_format_valid 'nat_ip'
is_ip_valid "$ip"
ip="$local_ip"
is_restart_format_valid "$restart"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Updating IP
if ! grep -q '^NAT=' "$HESTIA/data/ips/$ip"; then
	sed -i "s/^TIME/NAT='$nat_ip'\nTIME/g" "$HESTIA/data/ips/$ip"
	old_nat=''
else
	old_nat="$(get_ip_value '$NAT')"
	sed -i "s/^NAT=.*/NAT='$nat_ip'/" "$HESTIA/data/ips/$ip"
fi

old="${old_nat:-$ip}"
new="${nat_ip:-$ip}"
old_esc="${old//./\\.}"

# Updating WEB configs
if [ -n "$old_nat" ] && [ "$old" != "$new" ] && [ -n "$WEB_SYSTEM" ]; then
	web_changed=0
	for user in $("$BIN/v-list-users" list); do
		web_conf="$HESTIA/data/users/$user/web.conf"
		if [ -f "$web_conf" ] && grep -qE "(^| )IP='${old_esc}'" "$web_conf"; then
			sed -i -E "s/(^| )IP='${old_esc}'/\1IP='${new}'/g" "$web_conf"
			"$BIN/v-rebuild-web-domains" "$user" no
			web_changed=1
		fi
	done
	if [ "$web_changed" -eq 1 ]; then
		"$BIN/v-restart-web" "$restart"
		if [ -n "$PROXY_SYSTEM" ]; then
			"$BIN/v-restart-proxy" "$restart"
		fi
	fi
fi

# Updating DNS configs
if [ "$old" != "$new" ] && [ -n "$DNS_SYSTEM" ]; then
	dns_changed=0
	for user in $("$BIN/v-list-users" list); do
		user_dns_changed=0
		dns_conf="$HESTIA/data/users/$user/dns.conf"
		if [ -f "$dns_conf" ] && grep -qE "(^| )IP='${old_esc}'" "$dns_conf"; then
			sed -i -E "s/(^| )IP='${old_esc}'/\1IP='${new}'/g" "$dns_conf"
			user_dns_changed=1
		fi
		for zone_conf in "$HESTIA/data/users/$user/dns/"*.conf; do
			if [ -f "$zone_conf" ] && grep -qE "(^|[^0-9.])${old_esc}([^0-9.]|$)" "$zone_conf"; then
				sed -i -E "s/(^|[^0-9.])${old_esc}([^0-9.]|$)/\1${new}\2/g" "$zone_conf"
				user_dns_changed=1
			fi
		done
		if [ "$user_dns_changed" -eq 1 ]; then
			"$BIN/v-rebuild-dns-domains" "$user" no
			dns_changed=1
		fi
	done
	if [ "$dns_changed" -eq 1 ]; then
		"$BIN/v-restart-dns" "$restart"
	fi
fi

# Updating FTP
if [ -n "$FTP_SYSTEM" ] && [ "$old_nat" != "$nat_ip" ]; then
	ftp_conf="$(find /etc -maxdepth 2 -name "$FTP_SYSTEM.conf" 2> /dev/null | head -n1)"
	if [ -n "$ftp_conf" ] && [ -e "$ftp_conf" ]; then
		if [ -n "$old_nat" ]; then
			sed -i -E "s/(^|[^0-9.])${old_esc}([^0-9.]|$)/\1${new}\2/g" "$ftp_conf"
		fi
		if [ "$FTP_SYSTEM" = 'vsftpd' ]; then
			if grep -q '^pasv_address=' "$ftp_conf"; then
				if [ -z "$nat_ip" ]; then
					sed -i '/^pasv_address=/d' "$ftp_conf"
				else
					sed -i "s/^pasv_address=.*/pasv_address=$nat_ip/" "$ftp_conf"
				fi
			elif [ -n "$nat_ip" ]; then
				echo "pasv_address=$nat_ip" >> "$ftp_conf"
			fi
		fi
	fi
	if [ "$FTP_SYSTEM" = 'proftpd' ]; then
		ext_ip_conf="/etc/$FTP_SYSTEM/conf.d/external_ip.conf"
		if [ -n "$nat_ip" ]; then
			mkdir -p "/etc/$FTP_SYSTEM/conf.d"
			echo "MasqueradeAddress ${nat_ip}" > "$ext_ip_conf"
		else
			rm -f "$ext_ip_conf"
		fi
	fi
	"$BIN/v-restart-ftp" "$restart"
fi

# Updating firewall
if [ -n "$old_nat" ] && [ "$old" != "$new" ] && [ -n "$FIREWALL_SYSTEM" ]; then
	fw_changed=0
	for fw_conf in "$HESTIA/data/firewall/"*.conf; do
		if [ -f "$fw_conf" ] && grep -qE "(^|[^0-9.])${old_esc}([^0-9.]|$)" "$fw_conf"; then
			sed -i -E "s/(^|[^0-9.])${old_esc}([^0-9.]|$)/\1${new}\2/g" "$fw_conf"
			fw_changed=1
		fi
	done
	if [ "$fw_changed" -eq 1 ]; then
		"$BIN/v-update-firewall"
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "IP NAT address changed (IP: $ip, NAT IP: $nat_ip)."
log_event "$OK" "$ARGUMENTS"

exit
